{
  "manifest_version": 3,
  "name": "Disney+ Hotstar subs",
  "version": "1.0",
  "description": "Restyle Disney+ Hotstar subtitles.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "matches": [
        "https://*.hotstar.com/*",
        "https://hotstar.com/*",
        "https://*.apps.disneyplus.com/*",
        "https://apps.disneyplus.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}